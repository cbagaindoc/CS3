class Library:

  def borrow_book(self, title, borrower="Not specified", days=7):
    print(f"Book: {title}")
    print(f"Borrower: {borrower}")
    print(f"Borrowing period: {days} days\n")


my_library = Library()

  # 1 argument: Only title provided
my_library.borrow_book("Noli Me Tangere")

  # 2 arguments: Title and borrower provided
my_library.borrow_book("El Filibusterismo", "Maria")

  # 3 arguments: Title, borrower, and days provided
my_library.borrow_book("Florante at Laura", "Jose", 16)
